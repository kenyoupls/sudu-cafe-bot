# Copy this file to .env on the server and fill it in. NEVER upload .env to GitHub.

# ── Telegram ──
TELEGRAM_BOT_TOKEN=paste_token_from_BotFather
# Use /chatid inside each group to get these (they start with -100...)
OWNER_GROUP_ID=
STAFF_GROUP_ID=
# Owners' personal IDs, comma-separated. Use /whoami to get yours.
OWNER_USER_IDS=

# ── Google Sheet ──
# The long ID in the Sheet's web address: docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=
GOOGLE_SHEETS_CREDS_FILE=credentials.json

# ── AI (free key from aistudio.google.com, on a project with NO billing) ──
GEMINI_API_KEY=
# Optional, rarely needed:
# AI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# AI_CHECK_MODEL=gemini-3.5-flash
# GROQ_API_KEY=            (free backup from console.groq.com)

CAFE_NAME=Sudu
TIMEZONE=Asia/Kuala_Lumpur
